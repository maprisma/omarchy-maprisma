#!/bin/sh
# Open or close the app, or hand the user-approved install to a terminal.
set -eu
app=$(command -v maprisma 2>/dev/null || true)
# Installed by install-appimage but ~/.local/bin not on PATH: used only when the installer would accept
# that folder (ours, written only by us, no symlink or folder others may change above it) and the app
# there is our own regular file, not a link.
if [ -z "$app" ]; then
  fallback=$HOME/.local/bin/maprisma
  if [ -f "$fallback" ] && [ ! -L "$fallback" ] && [ -O "$fallback" ] && [ -x "$fallback" ] &&
    . "${0%/*}/folder-checks.sh" && private_tree "$HOME/.local/bin"; then
    app=$fallback
  fi
fi
launch_app() {
  if [ "$app" = "$HOME/.local/bin/maprisma" ] && [ ! -e /usr/lib/libfuse.so.2 ]; then
    APPIMAGE_EXTRACT_AND_RUN=1 exec "$app" --toggle
  fi
  exec "$app" --toggle
}
case "${1:-}" in
  --probe)
    [ "$#" -eq 1 ] && [ -n "$app" ]
    ;;
  --install)
    [ "$#" -eq 1 ] || exit 2
    [ -z "$app" ] || launch_app
    if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
      # No terminal to show the install in: say so instead of doing nothing.
      if command -v notify-send >/dev/null 2>&1; then
        notify-send -a Maprisma "Maprisma could not be installed" \
          "No terminal launcher (xdg-terminal-exec) was found. See the plugin README for the manual install."
      fi
      exit 1
    fi
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    exec xdg-terminal-exec --title='Install Maprisma' -- /bin/sh "$script_dir/install-appimage"
    ;;
  '')
    [ -n "$app" ] || exit 1
    launch_app
    ;;
  *) exit 2 ;;
esac
